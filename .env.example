# .env.example - 環境變數範本

# OpenAI API 配置
OPENAI_API_KEY=sk-proj-your-api-key-here
OPENAI_MODEL_NAME=gpt-4o-mini
OPENAI_API_BASE=

# Prometheus 配置 (用於 Quick Observability 功能)
# 如果不設定,將使用 Mock 數據進行測試
# 範例: PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_URL=

# Prometheus 認證配置 (可選)
# API Key / Bearer Token
PROMETHEUS_API_KEY=

# 自定義 Headers (可選)
# 格式: Header1:Value1,Header2:Value2
# 範例: PROMETHEUS_HEADERS=X-API-Key:your-key,X-Custom-Header:value
PROMETHEUS_HEADERS=

# 說明:
# - OPENAI_API_KEY: 你的 OpenAI API Key (必填)
# - OPENAI_MODEL_NAME: 使用的模型名稱 (預設: gpt-4o-mini)
# - OPENAI_API_BASE: 自定義 API Base URL,用於 Azure OpenAI 或代理 (可選)
# - PROMETHEUS_URL: Prometheus 服務器 URL,用於 Quick Observability 功能 (可選)
# - PROMETHEUS_API_KEY: Prometheus API Key 或 Bearer Token (可選)
# - PROMETHEUS_HEADERS: 自定義 HTTP Headers,格式為 Key:Value,Key:Value (可選)
#
# 使用方法:
# 1. 複製此檔案為 .env
# 2. 填入你的 OPENAI_API_KEY
# 3. 根據需要調整其他配置
