ceSaturationAlert\n        expr: 'frontend_resource_saturation > 0.8'\n        for: 5m\n        labels:\n          severity: critical\n        annotations:\n          summary: \"Frontend Resource Saturation is above 80%\"\n          description: \"Current resource saturation is {{ $value }}\"",
