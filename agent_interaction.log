{
  "generatedRules": "groups:\n  - name: slo-rules\n    rules:\n      - record: api_availability\n        expr: (sum(rate(http_requests_total{job=\"guestbook-ui\", status=\"200\"}[30d])) / sum(rate(http_requests_total{job=\"guestbook-ui\"}[30d]))) * 100\n        labels:\n          slo: \"API Availability\"\n      - alert: ApiAvailabilityAlert\n        expr: (sum(rate(http_requests_total{job=\"guestbook-ui\", status=\"200\"}[30d])) / sum(rate(http_requests_total{job=\"guestbook-ui\"}[30d])) < 99.9)\n        for: 1h\n        labels:\n          severity: critical\n        annotations:\n          summary: \"API Availability below target\"\n          description: \"API Availability is below 99.9% over the last 30 days.\"\n\n      - record: api_latency\n        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"guestbook-ui\"}[30d])) by (le))\n        labels:\n          slo: \"API Latency\"\n      - alert: ApiLatencyAlert\n        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"guestbook-ui\"}[30d])) by (le)) > 0.2\n        for: 1h\n        labels:\n          severity: critical\n        annotations:\n          summary: \"API Latency above target\"\n          description: \"API Latency is above 200ms (0.2s) over the last 30 days.\",\n",
  "generatedDashboard": "{\n  \"panels\": [\n    {\n      \"type\": \"graph\",\n      \"title\": \"API Availability\",\n      \"targets\": [\n        {\n          \"expr\": \"api_availability\",\n          \"format\": \"time_series\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Availability\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ],\n      \"legend\": {\n        \"show\": true\n      }\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"API Latency (95th Percentile)\",\n      \"targets\": [\n        {\n          \"expr\": \"api_latency\",\n          \"format\": \"time_series\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"ms\",\n          \"label\": \"Latency (ms)\",\n          \"min\": 0\n        }\n      ],\n      \"legend\": {\n        \"show\": true\n      }\n    }\n  ],\n  \"title\": \"SLO Dashboard\",\n  \"schemaVersion\": 26,\n  \"version\": 1\n}"
