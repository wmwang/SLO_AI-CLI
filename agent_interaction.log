{
  "generatedRules": "groups:\n  - name: service-slos\n    rules:\n      - record: error_rate\n        expr: 'sum(rate(http_requests_total{job=\"guestbook-ui\", status!=\"200\"}[5m])) / sum(rate(http_requests_total{job=\"guestbook-ui\"}[5m])) * 100'\n        labels:\n          service: \"guestbook-ui\"\n      - alert: HighErrorRate\n        expr: 'error_rate > 1'\n        for: 30d\n        labels:\n          severity: critical\n        annotations:\n          summary: \"High Error Rate detected for guestbook UI\"\n          description: \"The error rate has exceeded 1% for the last 30 days.\"\n\n      - record: cpu_utilization\n        expr: 'avg(rate(container_cpu_usage_seconds_total{job=\"guestbook-ui\"}[5m])) by (pod) * 100'\n        labels:\n          service: \"guestbook-ui\"\n      - alert: HighCpuUtilization\n        expr: 'cpu_utilization > 70'\n        for: 30d\n        labels:\n          severity: warning\n        annotations:\n          summary: \"High CPU Utilization detected for guestbook UI\"\n          description: \"The CPU utilization has exceeded 70% for the last 30 days.\",\n",
  "generatedDashboard": "{\n  \"panels\": [\n    {\n      \"type\": \"graph\",\n      \"title\": \"Error Rate\",\n      \"targets\": [\n        {\n          \"expr\": \"error_rate\",\n          \"format\": \"time_series\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Error Rate\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"CPU Utilization\",\n      \"targets\": [\n        {\n          \"expr\": \"cpu_utilization\",\n          \"format\": \"time_series\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"CPU Utilization\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    }\n  ]\n}",
