DETAILS:
{
  "generatedRules": "groups:\n  - name: SLOs\n    rules:\n      - record: api_availability\n        expr: (sum(rate(http_requests_total{job=\"guestbook-ui\", status=\"200\"}[30d])) / sum(rate(http_requests_total{job=\"guestbook-ui\"}[30d]))) * 100\n        labels:\n          slo: \"API Availability\"\n\n      - alert: ApiAvailabilityAlert\n        expr: api_availability < 99.9\n        for: 30d\n        labels:\n          severity: critical\n        annotations:\n          summary: \"API Availability is below target\"\n          description: \"API Availability is at {{ $value }}%, which is below the target of 99.9% over the last 30 days.\"\n\n      - record: api_latency\n        expr: histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"guestbook-ui\"}[30d])) by (le))\n        labels:\n          slo: \"API Latency\"\n\n      - alert: ApiLatencyAlert\n        expr: api_latency > 0.2\n        for: 30d\n        labels:\n          severity: warning\n        annotations:\n          summary: \"API Latency is above target\"\n          description: \"API Latency is at {{ $value }}s, which is above the target of 200ms over the last 30 days.\"\n\n      - record: service_traffic\n        expr: sum(rate(http_requests_total{job=\"guestbook-ui\"}[30d]))\n        labels:\n          slo: \"Service Traffic\"\n\n      - alert: ServiceTrafficAlert\n        expr: service_traffic < 10000\n        for: 30d\n        labels:\n          severity: info\n        annotations:\n          summary: \"Service Traffic is below target\"\n          description: \"Service Traffic is at {{ $value }} requests, which is below the target of 10000 requests over the last 30 days.\",",
  "generatedDashboard": "{\n  \"panels\": [\n    {\n      \"type\": \"graph\",\n      \"title\": \"API Availability\",\n      \"targets\": [\n        {\n          \"expr\": \"api_availability\",\n          \"legendFormat\": \"API Availability\",\n          \"refId\": \"A\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Availability\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"API Latency\",\n      \"targets\": [\n        {\n          \"expr\": \"api_latency\",\n          \"legendFormat\": \"API Latency (95th Percentile)\",\n          \"refId\": \"B\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"seconds\",\n          \"label\": \"Latency\",\n          \"min\": 0,\n          \"max\": 1\n        }\n      ]\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"Service Traffic\",\n      \"targets\": [\n        {\n          \"expr\": \"service_traffic\",\n          \"legendFormat\": \"Service Traffic\",\n          \"refId\": \"C\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"short\",\n          \"label\": \"Requests\",\n          \"min\": 0\n        }\n      ]\n    }\n  ],\n  \"title\": \"SLO Dashboard\",\n  \"schemaVersion\": 26,\n  \"version\": 1\n}"
}
