{
  "generatedRules": "groups:\n  - name: frontend-api-slo\n    rules:\n      - record: frontend_api_availability\n        expr: 'sum(rate(http_requests_total{status=~\"2..\"}[30d])) / sum(rate(http_requests_total[30d])) * 100'\n      - alert: FrontendAPIAvailabilityAlert\n        expr: 'frontend_api_availability < 99.9'\n        for: 5m\n        labels:\n          severity: critical\n        annotations:\n          summary: \"Frontend API Availability is below 99.9%\"\n          description: \"Current availability is below the target.\"\n\n      - record: frontend_response_latency\n        expr: 'histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[30d])) by (le))'\n      - alert: FrontendResponseLatencyAlert\n        expr: 'frontend_response_latency > 0.2'\n        for: 5m\n        labels:\n          severity: warning\n        annotations:\n          summary: \"Frontend Response Latency is above 200ms\"\n          description: \"Current latency is above the target.\"\n\n      - record: frontend_traffic_volume\n        expr: 'sum(rate(http_requests_total[30d]))'\n      - alert: FrontendTrafficVolumeAlert\n        expr: 'frontend_traffic_volume < 10'\n        for: 5m\n        labels:\n          severity: warning\n        annotations:\n          summary: \"Frontend Traffic Volume is low\"\n          description: \"Current traffic volume is below expected levels.\"\n\n      - record: frontend_error_rate\n        expr: 'sum(rate(http_requests_total{status=~\"5..\"}[30d])) / sum(rate(http_requests_total[30d])) * 100'\n      - alert: FrontendErrorRateAlert\n        expr: 'frontend_error_rate > 0.1'\n        for: 5m\n        labels:\n          severity: critical\n        annotations:\n          summary: \"Frontend Error Rate is above acceptable levels\"\n          description: \"Current error rate is above the target.\"\n\n      - record: frontend_resource_saturation\n        expr: 'max_over_time(container_cpu_usage_seconds_total[30d]) / sum(container_spec_cpu_quota) > bool 0.8'\n      - alert: FrontendResourceSaturationAlert\n        expr: 'frontend_resource_saturation'\n        for: 5m\n        labels:\n          severity: critical\n        annotations:\n          summary: \"Frontend Resource Saturation is high\"\n          description: \"Resource usage is above acceptable limits.\"",
