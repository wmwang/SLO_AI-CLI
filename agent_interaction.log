  "generatedRules": "groups:\n  - name: guestbook-ui-slos\n    rules:\n      - record: service_saturation\n        expr: (sum(rate(container_cpu_usage_seconds_total{namespace=\"default\", pod=~\"guestbook-ui.*\"}[5m])) by (pod) / sum(kube_pod_container_resource_limits_cpu_cores{namespace=\"default\", pod=~\"guestbook-ui.*\"}) by (pod)) * 100\n        labels:\n          slo: \"slo-004\"\n      - alert: ServiceSaturationHigh\n        expr: service_saturation > 80\n        for: 5m\n        labels:\n          severity: critical\n          slo: \"slo-004\"\n        annotations:\n          summary: \"High Service Saturation for Guestbook UI\"\n          description: \"The service saturation is above 80% for more than 5 minutes.\"\n\n      - record: readiness_probe_success_rate\n        expr: (sum(increase(http_requests_total{job=\"app\", status=\"200\"}[5m])) by (pod) / sum(increase(http_requests_total{job=\"app\"}[5m])) by (pod)) * 100\n        labels:\n          slo: \"slo-005\"\n      - alert: ReadinessProbeFailure\n        expr: readiness_probe_success_rate < 99.9\n        for: 5m\n        labels:\n          severity: critical\n          slo: \"slo-005\"\n        annotations:\n          summary: \"Low Readiness Probe Success Rate for Guestbook UI\"\n          description: \"The readiness probe success rate is below 99.9% for more than 5 minutes.\"\n\n      - record: liveness_probe_success_rate\n        expr: (sum(increase(http_requests_total{job=\"app\", status=\"200\"}[5m])) by (pod) / sum(increase(http_requests_total{job=\"app\"}[5m])) by (pod)) * 100\n        labels:\n          slo: \"slo-006\"\n      - alert: LivenessProbeFailure\n        expr: liveness_probe_success_rate < 99.9\n        for: 5m\n        labels:\n          severity: critical\n          slo: \"slo-006\"\n        annotations:\n          summary: \"Low Liveness Probe Success Rate for Guestbook UI\"\n          description: \"The liveness probe success rate is below 99.9% for more than 5 minutes.\",\n",
  "generatedDashboard": "{\n  \"panels\": [\n    {\n      \"type\": \"graph\",\n      \"title\": \"Service Saturation\",\n      \"targets\": [\n        {\n          \"expr\": \"service_saturation\",\n          \"legendFormat\": \"Saturation\",\n          \"refId\": \"A\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Saturation (%)\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"Readiness Probe Success Rate\",\n      \"targets\": [\n        {\n          \"expr\": \"readiness_probe_success_rate\",\n          \"legendFormat\": \"Readiness Success Rate\",\n          \"refId\": \"B\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Success Rate (%)\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    },\n    {\n      \"type\": \"graph\",\n      \"title\": \"Liveness Probe Success Rate\",\n      \"targets\": [\n        {\n          \"expr\": \"liveness_probe_success_rate\",\n          \"legendFormat\": \"Liveness Success Rate\",\n          \"refId\": \"C\"\n        }\n      ],\n      \"yaxes\": [\n        {\n          \"format\": \"percent\",\n          \"label\": \"Success Rate (%)\",\n          \"min\": 0,\n          \"max\": 100\n        }\n      ]\n    }\n  ],\n  \"title\": \"Guestbook UI SLO Dashboard\"\n}"
