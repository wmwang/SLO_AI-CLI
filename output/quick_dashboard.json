{
  "dashboard": {
    "id": null,
    "uid": "dbaws-dashboard",
    "title": "DBAWS Monitoring Dashboard",
    "tags": [],
    "timezone": "browser",
    "panels": [
      {
        "type": "graph",
        "title": "Total HTTP Requests",
        "description": "Total number of HTTP requests received by the application.",
        "targets": [
          {
            "expr": "sum(rate(http_requests_total{app=\"dbaws\"}[5m]))",
            "legendFormat": "Total Requests",
            "refId": "A"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 6
        }
      },
      {
        "type": "graph",
        "title": "HTTP Request Duration",
        "description": "Histogram of HTTP request durations in seconds.",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{app=\"dbaws\"}[5m])) by (le))",
            "legendFormat": "95th Percentile",
            "refId": "A"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 6,
          "w": 12,
          "h": 6
        }
      },
      {
        "type": "gauge",
        "title": "Total CPU Seconds",
        "description": "Total CPU time consumed by the application in seconds.",
        "targets": [
          {
            "expr": "sum(rate(process_cpu_seconds_total{app=\"dbaws\"}[5m]))",
            "legendFormat": "CPU Seconds",
            "refId": "A"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 6
        }
      },
      {
        "type": "gauge",
        "title": "Resident Memory Usage",
        "description": "Current resident memory usage of the application in bytes.",
        "targets": [
          {
            "expr": "process_resident_memory_bytes{app=\"dbaws\"}",
            "legendFormat": "Memory Usage",
            "refId": "A"
          }
        ],
        "gridPos": {
          "x": 0,
          "y": 18,
          "w": 12,
          "h": 6
        }
      }
    ],
    "schemaVersion": 26,
    "version": 1,
    "refresh": "5s"
  },
  "overwrite": true
}