{
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "datasource": "Prometheus",
      "type": "graph",
      "title": "Average CPU Utilization",
      "targets": [
        {
          "expr": "avg(rate(container_cpu_usage_seconds_total{job=\"kubelet\", image! = \"\", container! = \"POD\"}[5m])) by (pod)",
          "format": "time_series",
          "intervalFactor": 2,
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "fill": 1,
      "xaxis": {
        "mode": "time"
      },
      "yaxes": [
        {
          "format": "percent",
          "label": "CPU Utilization",
          "min": 0,
          "max": 1
        },
        {
          "format": "short"
        }
      ],
      "thresholds": [
        {
          "value": 0.7,
          "colorMode": "critical",
          "op": ">=",
          "fill": true,
          "line": true
        },
        {
          "value": 0.9,
          "colorMode": "warning",
          "op": ">=",
          "fill": true,
          "line": true
        }
      ]
    }
  ],
  "schemaVersion": 26,
  "version": 1,
  "refresh": "5s"
}